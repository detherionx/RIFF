# Local Compose only. Replace with a random URL-safe secret before running.
POSTGRES_PASSWORD=replace-with-a-long-random-secret
# Host Python API; Compose sets its own private PostgreSQL URL.
DATABASE_URL=postgresql://riff:replace-with-a-long-random-secret@localhost:5432/riff
# Next.js server-only URL. Never prefix this with NEXT_PUBLIC_.
RIFF_API_URL=http://localhost:8000
# Needed only for direct browser access to a separate API origin.
CORS_ORIGINS=http://localhost:3000
